@startuml diagrama_de_pacotes
skinparam packageStyle rectangle
left to right direction

package "br.pucminas.aluguel" {

  package "view" as view {
    package "web" as web
  }

  package "controller" as controller

  package "model" as model {
    package "usuario" as m_usuario
    package "pedido" as m_pedido
    package "contrato" as m_contrato
    package "automovel" as m_automovel
  }

  package "service" as service {
    package "pedido" as s_pedido
    package "contrato" as s_contrato
    package "credito" as s_credito
  }

  package "repository" as repository

  package "util" as util
}

view ..> controller : usa
web ..> controller : requisições HTTP
controller ..> service : delega regras de negócio
controller ..> model : manipula entidades
service ..> repository : persiste/consulta
service ..> model : opera sobre entidades
repository ..> model : mapeia entidades
service ..> util
controller ..> util

note top of view
  Subsistema de construção
  dinâmica das páginas web
end note

note bottom of service
  Subsistema de gestão de
  pedidos e contratos
end note
@enduml
