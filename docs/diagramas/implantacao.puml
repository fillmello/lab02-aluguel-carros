@startuml diagrama_de_implantacao
left to right direction
skinparam componentStyle rectangle

node "Computador do cliente" as client {
  artifact "Navegador web" as clientBrowser
}

node "Computador do agente" as agent {
  artifact "Navegador web" as agentBrowser
}

node "Servidor central" as central {
  artifact "Aplicação Java MVC" as application
  database "Repositório em memória" as memory
}

clientBrowser --> application : HTTPS/HTTP
agentBrowser --> application : HTTPS/HTTP
application --> memory : objetos em memória

note bottom of central
  Ambiente do protótipo local:
  localhost:8080
end note
@enduml
